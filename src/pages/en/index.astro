---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Milo Agudelo — Full Stack Developer"
  description="Portfolio of Milo Agudelo, Full Stack developer specialized in performance and social impact."
>
  <canvas id="stars" class="fixed inset-0 z-0 pointer-events-none"></canvas>

  <main class="relative z-10 h-screen flex flex-col items-center justify-center px-6 text-center text-white overflow-hidden">

    <h1 class="flex flex-nowrap items-center justify-center gap-2 text-[max(0.95rem,5.5vw)] font-extrabold leading-none m-0 whitespace-nowrap">
      <img
        id="avatar"
        src="/profile-picture.jpg"
        alt="Milo"
        class="inline-block w-12 h-12 sm:w-[max(2.5rem,5.5vw)] sm:h-[max(2.5rem,5.5vw)] rounded-xl sm:rounded-2xl object-cover object-top border-2 border-white shadow-[0_0_14px_rgba(255,255,255,0.2)] align-middle flex-shrink-0 transition-transform duration-100 hover:scale-105 cursor-pointer"
      />
      &nbsp;Milo's portfolio
    </h1>

    <p class="text-[max(0.95rem,5.5vw)] font-extrabold leading-none mt-1 mb-5 text-white/30 whitespace-nowrap">
      is under construction.
    </p>

    <p class="text-[clamp(0.5rem,1.1vw,0.75rem)] uppercase tracking-widest text-white/40 mb-8 flex flex-wrap justify-center gap-x-2 gap-y-1">
      <span>Full Stack Developer</span>
      <span class="text-white/20">·</span>
      <span>Social impact builder</span>
      <span class="text-white/20">·</span>
      <span>UI/UX Designer</span>
    </p>

    <div class="flex gap-5 items-center">
      <a href="https://github.com/MiloAgudelo" target="_blank" rel="noopener" aria-label="GitHub"
        class="flex items-center justify-center w-11 h-11 rounded-full border border-white/15 text-white/60 transition-all duration-200 hover:text-sky-400 hover:border-sky-400 hover:shadow-[0_0_16px_rgba(56,189,248,0.25)] hover:-translate-y-0.5">
        <svg class="w-[1.1rem] h-[1.1rem]" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 21.795 24 17.295 24 12c0-6.63-5.37-12-12-12"/></svg>
      </a>
      <a href="https://linkedin.com/in/camiloagudelojaramillo" target="_blank" rel="noopener" aria-label="LinkedIn"
        class="flex items-center justify-center w-11 h-11 rounded-full border border-white/15 text-white/60 transition-all duration-200 hover:text-sky-400 hover:border-sky-400 hover:shadow-[0_0_16px_rgba(56,189,248,0.25)] hover:-translate-y-0.5">
        <svg class="w-[1.1rem] h-[1.1rem]" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
      </a>
      <a href="https://instagram.com/milo_agudelo" target="_blank" rel="noopener" aria-label="Instagram"
        class="flex items-center justify-center w-11 h-11 rounded-full border border-white/15 text-white/60 transition-all duration-200 hover:text-sky-400 hover:border-sky-400 hover:shadow-[0_0_16px_rgba(56,189,248,0.25)] hover:-translate-y-0.5">
        <svg class="w-[1.1rem] h-[1.1rem]" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>
      </a>
      <a href="https://twitter.com/CamiloAgudeloJ" target="_blank" rel="noopener" aria-label="X"
        class="flex items-center justify-center w-11 h-11 rounded-full border border-white/15 text-white/60 transition-all duration-200 hover:text-sky-400 hover:border-sky-400 hover:shadow-[0_0_16px_rgba(56,189,248,0.25)] hover:-translate-y-0.5">
        <svg class="w-[1.1rem] h-[1.1rem]" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.747l7.73-8.835L1.254 2.25H8.08l4.253 5.622 5.91-5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      </a>
    </div>
  </main>

  <!-- Lightbox -->
  <div id="lightbox" class="hidden fixed inset-0 z-50 flex items-center justify-center backdrop-blur-md opacity-0 transition-opacity duration-300 cursor-default">
    <div id="lightbox-content" class="relative scale-95 transition-transform duration-300 w-fit">
      <img
        src="/profile-picture.jpg"
        alt="Milo Agudelo"
        class="block max-h-[85vh] max-w-[85vw] w-auto h-auto rounded-2xl border-2 border-white shadow-[0_0_0_5px_#fff]"
      />
      <div class="absolute inset-x-6 bottom-[4%] mx-auto box-border flex w-max max-w-[calc(100%-3rem)] min-w-0 items-center justify-center gap-[clamp(0.9rem,1.4vw,1.25rem)] px-[clamp(1.35rem,5vw,4rem)] py-[clamp(0.9rem,2.2vh,1.55rem)] rounded-full border-2 border-white/60 bg-gradient-to-b from-white/95 to-white/70 backdrop-blur-md text-gray-800 whitespace-nowrap cursor-default shadow-[inset_0_1.5px_0_rgba(255,255,255,1),inset_0_-1px_0_rgba(200,200,200,0.3),0_4px_24px_rgba(0,0,0,0.1)]">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-[clamp(1.2rem,2.6vw,2.25rem)] h-[clamp(1.2rem,2.6vw,2.25rem)] shrink-0 text-gray-500" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/>
        </svg>
        <span class="min-w-0 truncate font-semibold tracking-wide text-[clamp(1.15rem,2.7vw,2.65rem)]">Camilo Agudelo Jaramillo</span>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const canvas = document.getElementById('stars') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  type Star = { x: number; y: number; ox: number; oy: number; r: number; alpha: number; speed: number; dir: number; vx: number; vy: number };
  let stars: Star[] = [];
  const mouse = { x: -999, y: -999 };
  const RADIUS = 120, PUSH = 4;

  function resize() { canvas.width = window.innerWidth; canvas.height = window.innerHeight; }
  function init() {
    resize();
    stars = Array.from({ length: 200 }, () => {
      const x = Math.random() * canvas.width;
      const y = Math.random() * canvas.height;
      return { x, y, ox: x, oy: y, r: Math.random() * 1.4 + 0.3, alpha: Math.random(), speed: Math.random() * 0.008 + 0.003, dir: Math.random() > 0.5 ? 1 : -1, vx: 0, vy: 0 };
    });
  }
  function draw() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    for (const s of stars) {
      const dx = s.x - mouse.x, dy = s.y - mouse.y;
      const dist = Math.sqrt(dx * dx + dy * dy);
      if (dist < RADIUS && dist > 0) {
        const force = (RADIUS - dist) / RADIUS;
        s.vx += (dx / dist) * force * PUSH;
        s.vy += (dy / dist) * force * PUSH;
      }
      s.vx *= 0.88; s.vy *= 0.88;
      s.x += s.vx + (s.ox - s.x) * 0.04;
      s.y += s.vy + (s.oy - s.y) * 0.04;
      s.alpha += s.speed * s.dir;
      if (s.alpha >= 1 || s.alpha <= 0) s.dir *= -1;
      ctx.beginPath(); ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(255,255,255,${s.alpha})`; ctx.fill();
    }
    requestAnimationFrame(draw);
  }
  window.addEventListener('mousemove', e => { mouse.x = e.clientX; mouse.y = e.clientY; });
  window.addEventListener('mouseleave', () => { mouse.x = -999; mouse.y = -999; });
  window.addEventListener('resize', () => { resize(); init(); });
  init(); draw();

  // Lightbox
  const avatar = document.getElementById('avatar') as HTMLImageElement;
  const lightbox = document.getElementById('lightbox')!;
  const lightboxContent = document.getElementById('lightbox-content')!;

  avatar.addEventListener('click', () => {
    lightbox.classList.remove('hidden');
    requestAnimationFrame(() => {
      lightbox.classList.remove('opacity-0');
      lightboxContent.classList.remove('scale-95');
    });
  });

  lightbox.addEventListener('click', () => {
    lightbox.classList.add('opacity-0');
    lightboxContent.classList.add('scale-95');
    setTimeout(() => lightbox.classList.add('hidden'), 300);
  });

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') lightbox.click();
  });
</script>
