---
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { DesignSystemPage } from '@/components/design-system/DesignSystemPage';
import profilePictureLight from '../../assets/profile-picture-light.jpg';

const profilePic = await getImage({ src: profilePictureLight, format: 'webp', quality: 85 });
---

<BaseLayout
  title="Design System — Milo Agudelo"
  description="Design system for miloagudelo.com. Tokens, components, typography and visual rules."
>
  <DesignSystemPage client:load profileSrc={profilePic.src} locale="en" />
</BaseLayout>
