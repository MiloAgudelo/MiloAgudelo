---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { DesignSystemPage } from '@/components/design-system/DesignSystemPage';
import profilePictureLight from '../assets/profile-picture-light.jpg';

const profilePic = await getImage({ src: profilePictureLight, format: 'webp', quality: 85 });
---

<BaseLayout
  title="Design System · Milo Agudelo"
  description="Sistema de diseño de miloagudelo.com. Tokens, componentes, tipografía y reglas visuales."
>
  <DesignSystemPage client:load profileSrc={profilePic.src} />
</BaseLayout>
