---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { LandingPage } from '@/components/landing/LandingPage';
import profilePictureLight from '../assets/profile-picture-light.jpg';

const profilePic = await getImage({ src: profilePictureLight, format: 'webp', quality: 85 });
---

<BaseLayout
  title="Milo Agudelo — Full Stack Developer"
  description="Diseño y construyo webs y productos digitales de punta a punta: del primer trazo en Figma al deploy en producción."
>
  <LandingPage client:load profileSrc={profilePic.src} locale="es" />
</BaseLayout>
