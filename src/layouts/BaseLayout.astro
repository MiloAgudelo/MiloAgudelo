---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Font } from 'astro:assets';
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string;
  htmlClass?: string;
  /** Ruta (relativa o absoluta) de la imagen para Open Graph / Twitter. */
  ogImage?: string;
}

const { title, description = '', htmlClass = 'bg-background select-none', ogImage } = Astro.props;
const lang = Astro.currentLocale ?? 'es';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = ogImage ? new URL(ogImage, Astro.site) : undefined;
const ogLocale = lang === 'es' ? 'es_CO' : 'en_US';

// Strip the current locale prefix to get the base path for hreflang generation
const basePath = lang === 'es'
  ? Astro.url.pathname
  : Astro.url.pathname.replace(new RegExp(`^/${lang}(?=/|$)`), '') || '/';
---

<html lang={lang} class={htmlClass}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    {description && <meta name="description" content={description} />}

    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Milo Agudelo" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content={ogLocale} />
    {ogImageURL && <meta property="og:image" content={ogImageURL} />}
    <meta name="twitter:card" content={ogImageURL ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {ogImageURL && <meta name="twitter:image" content={ogImageURL} />}

    <slot name="head" />

    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" />

    <!-- hreflang para SEO multilenguaje -->
    <link rel="alternate" hreflang="es" href={new URL(getRelativeLocaleUrl('es', basePath), Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(getRelativeLocaleUrl('en', basePath), Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(getRelativeLocaleUrl('es', basePath), Astro.site)} />
  </head>
  <body>
    <slot />
  </body>
</html>
